# Copy to .env and fill in. Never commit the real .env.

# From @BotFather in Telegram
TELEGRAM_BOT_TOKEN=123456789:AAExampleTokenGoesHere

# Your personal chat id — message your bot once, then open
# https://api.telegram.org/bot<YOUR_TOKEN>/getUpdates and read result[].message.chat.id
TELEGRAM_CHAT_ID=123456789

# The searches to watch, one per line, each copied from that site's address bar.
# Use SEARCH_URLS for several; SEARCH_URL still works for a single search.
SEARCH_URLS="https://joymee.uz/?step=1&entity_purpose=long_term_rent&entity_type=apartment&district=199&region=59&currency=2&max_price=600&room_qty_min=2&room_qty_max=3&country=1&page=1,https://uybor.uz/listings?operationType__eq=rent&category__eq=7"

# --- optional ---
# Result pages always read per check, and the cap when a burst is detected
PAGES_TO_SCAN=2
MAX_PAGES_TO_SCAN=12
# Checks per process run, and seconds between them
POLL_ITERATIONS=1
POLL_INTERVAL_SECONDS=60
# Hard cap on messages per check, so a site glitch cannot flood you
MAX_NOTIFICATIONS_PER_CHECK=25
