{
  "name": "rent-watcher",
  "version": "1.0.0",
  "private": true,
  "description": "Watches filtered property searches on joymee.uz and uybor.uz, and pushes newly added listings to Telegram.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node src/index.js",
    "once": "node src/index.js --once",
    "seed": "node src/index.js --seed",
    "find-chat-id": "node scripts/find-chat-id.js",
    "test-telegram": "node src/index.js --test-telegram",
    "verify": "node scripts/verify-filters.js",
    "probe-sites": "node scripts/probe-sites.js",
    "test-access": "node scripts/test-access.js"
  }
}
